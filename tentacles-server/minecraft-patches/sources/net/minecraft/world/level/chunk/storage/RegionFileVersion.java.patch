+    // Tentacles start - Per-world region compression format
+    public static RegionFileVersion getSelected(net.minecraft.resources.ResourceKey<net.minecraft.world.level.Level> dimension) {
+        // Can't use PurpurWorldConfig here as WorldUpgrader (--forceUpgrade) happens before the world is loaded
+        // Speed should be fine as we are only doing this once per world now
+        String format = org.purpurmc.purpur.PurpurConfig.config
+                .getString("world-settings." + dimension.identifier() + ".settings.region-file-compression", 
+                           "default");
+
+        if (format.equals("default")) {
+            return getSelected();
+        }
+
+        RegionFileVersion version = VERSIONS_BY_NAME.get(format);
+        if (version != null) {
+            return version;
+        } else {
+            LOGGER.error(
+                    "Invalid `region-file-compression` value `{}` for world `{}`. Please use one of: {}, {}",
+                    format,
+                    dimension,
+                    String.join(", ", VERSIONS_BY_NAME.keySet()),
+                    "default"
+            );
+            
+            return getSelected();
+        }
+    }
+    // Tentacles end- Per-world region compression format
+
     public static boolean isValidVersion(final int version) {
         return VERSIONS.containsKey(version);
     }
